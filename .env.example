# HTTP CONNECT proxy for provider result downloads and S3.
# Provider submit/poll requests use this only when IMAGE_API_USE_PROXY=true.
OUTBOUND_HTTP_PROXY=

# Redis uses its native TCP protocol and cannot use OUTBOUND_HTTP_PROXY.
# Point this at Redis directly or at a Redis TCP tunnel/sidecar.
REDIS_URL=redis://redis:6379/0
GENERATE_RESULT_QUEUE_KEY=generate_results

IMAGE_API_BASE_URL=https://replace-with-provider.example
IMAGE_API_USE_PROXY=false
IMAGE_API_KEY=replace-me
IMAGE_API_MODEL=nano-banana-pro
IMAGE_API_CONNECT_TIMEOUT_SECONDS=5
IMAGE_API_READ_TIMEOUT_SECONDS=20
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
IMAGE_DOWNLOAD_DIRECT_FALLBACK=true

REAL_TO_RENDER_POLL_INTERVAL_SECONDS=10
# 320s is a soft threshold: polling becomes less frequent but does not fail.
REAL_TO_RENDER_MAX_WAIT_SECONDS=320
REAL_TO_RENDER_DELAYED_POLL_INTERVAL_SECONDS=60
REAL_TO_RENDER_HARD_WAIT_SECONDS=1800
# Result recovery must remain below the provider URL's two-hour lifetime.
REAL_TO_RENDER_RESULT_RECOVERY_SECONDS=5400
REAL_TO_RENDER_RETRY_INTERVALS_SECONDS=2,5,15,30,60
REAL_TO_RENDER_POLL_JOB_RETRY_MAX=5
REAL_TO_RENDER_JOB_TIMEOUT_SECONDS=320
REAL_TO_RENDER_STATE_TTL_SECONDS=86400
REAL_TO_RENDER_RECOVERY_INTERVAL_SECONDS=15
REAL_TO_RENDER_ORPHAN_GRACE_SECONDS=75
REAL_TO_RENDER_PIPELINE_VERSION=real2render-t41-t51-t52-sking-ddj-v54-v1
REAL_TO_RENDER_TEMPLATE_PATHS=/app/templates/template41.png,/app/templates/template51.png,/app/templates/template52.png
REAL_TO_RENDER_PROMPT_FILE=/app/prompts/real_to_render.zh-hans.txt
REAL_TO_RENDER_IMAGE_SIZE=1K
REAL_TO_RENDER_ASPECT_RATIO=1:1

RENDER_TO_UV_TASK=worker_tasks.task_render_to_uv
RENDER_TO_UV_JOB_TIMEOUT_SECONDS=120
RENDER_TO_UV_RETRY_MAX=5
RENDER_TO_UV_RETRY_INTERVALS_SECONDS=5,15,30,60,120

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=
